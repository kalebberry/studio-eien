---
import { getCollection, render } from 'astro:content';
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro';
import CaseStudyHero from '../../components/astro/work/CaseStudyHero.astro';
import CaseStudyMeta from '../../components/astro/work/CaseStudyMeta.astro';
import NextProjectNav from '../../components/astro/work/NextProjectNav.astro';

export async function getStaticPaths() {
  const projects = await getCollection('work');
  return projects.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

const projects = (await getCollection('work')).sort(
  (a, b) => a.data.order - b.data.order
);
const currentIndex = projects.findIndex((project) => project.id === entry.id);
const following = projects[(currentIndex + 1) % projects.length];
const nextProject = data.nextProject
  ? projects.find((project) => project.id === data.nextProject?.slug) ?? following
  : following;
const nextData = nextProject.data;
---

<CaseStudyLayout title={data.title} description={`${data.subtitle} — ${data.tagline}`}>
  <nav class='cs-breadcrumb' aria-label='Breadcrumb'>
    <div class='container' data-type='wide'>
      <a href='/work' class='cs-breadcrumb__link'>
        <span aria-hidden='true'>←</span>
        <span>Archive / Works</span>
      </a>
      <span class='cs-breadcrumb__current'>{data.japaneseTitle} // {data.title}</span>
    </div>
  </nav>

  <CaseStudyHero
    title={data.title}
    japaneseTitle={data.japaneseTitle}
    subtitle={data.subtitle}
    tagline={data.tagline}
    heroImage={data.heroImage}
    heroImageAlt={data.heroImageAlt}
    signature={`SECTION: ${data.title.toUpperCase()} ⟡ OVERVIEW V.01`}
  />

  <CaseStudyMeta
    client={data.client}
    year={data.year}
    roles={data.roles}
    deliverables={data.deliverables}
    liveUrl={data.liveUrl}
  />

  <Content />

  {projects.length > 1 && (
    <NextProjectNav
      nextSlug={nextProject.id}
      nextTitle={nextData.title}
      nextTagline={nextData.tagline}
      nextThumbnail={nextData.heroImage}
      nextJapaneseTitle={nextData.japaneseTitle}
    />
  )}
</CaseStudyLayout>
