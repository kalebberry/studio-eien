---
import { getCollection, render } from 'astro:content';
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro';
import CaseStudyHero from '../../components/astro/work/CaseStudyHero.astro';
import CaseStudyMeta from '../../components/astro/work/CaseStudyMeta.astro';
import EditorialSection from '../../components/astro/work/EditorialSection.astro';
import VisualFeature from '../../components/astro/work/VisualFeature.astro';
import AsymmetricGallery from '../../components/astro/work/AsymmetricGallery.astro';
import TechHighlights from '../../components/astro/work/TechHighlights.astro';
import ProjectReflection from '../../components/astro/work/ProjectReflection.astro';
import NextProjectNav from '../../components/astro/work/NextProjectNav.astro';

export async function getStaticPaths() {
	const projects = await getCollection('work');
	return projects.map((entry) => {
		const rawId = entry.id || (entry as any).slug || '';
		const slug = rawId.replace(/\.md$/, '').replace(/\.mdx$/, '');
		return {
			params: { slug },
			props: { entry, slug },
		};
	});
}

const { entry, slug } = Astro.props;
const { data } = entry;

// Render markdown body content
let Content: any = null;
if (typeof (entry as any).render === 'function') {
	const rendered = await (entry as any).render();
	Content = rendered.Content;
} else if (typeof render === 'function') {
	const rendered = await render(entry);
	Content = rendered.Content;
}

// Next project defaults if not specified in frontmatter
const nextProjectData = data.nextProject || {
	slug: slug === 'koshi' ? 'kangae' : slug === 'kangae' ? 'mika' : 'koshi',
	title: slug === 'koshi' ? 'Kangae' : slug === 'kangae' ? 'Mika' : 'Kōshi',
	tagline:
		slug === 'koshi'
			? 'Think with AI, not through AI.'
			: slug === 'kangae'
				? 'A calmer way to manage your money.'
				: 'Structure creates space for creativity.',
	thumbnail:
		slug === 'koshi'
			? 'https://ik.imagekit.io/sorudev/Studio%20Eien/Backgrounds/download_XmsTAxTHE.png?updatedAt=1794726867267'
			: slug === 'kangae'
				? 'https://ik.imagekit.io/sorudev/Studio%20Eien/Backgrounds/lakewithleaves_FY9DAwWQ_.png?updatedAt=1794727823633'
				: 'https://ik.imagekit.io/sorudev/Studio%20Eien/Backgrounds/mountain_INo60XpUz.png?updatedAt=1794727824146',
};
---

<CaseStudyLayout title={data.title} description={`${data.subtitle} — ${data.tagline}`}>
	<!-- Breadcrumb Navigation -->
	<nav class='cs-breadcrumb' aria-label='Breadcrumb'>
		<div class='container' data-type='wide'>
			<a href='/work' class='cs-breadcrumb__link'>
				<span aria-hidden='true'>←</span>
				<span>Archive / Works</span>
			</a>
			<span class='cs-breadcrumb__current'>{data.japaneseTitle} // {data.title}</span>
		</div>
	</nav>

	<!-- 1. Project Hero & Introduction -->
	<CaseStudyHero
		title={data.title}
		japaneseTitle={data.japaneseTitle}
		subtitle={data.subtitle}
		tagline={data.tagline}
		heroImage={data.heroImage}
		heroImageAlt={data.heroImageAlt}
		signature={`SECTION: ${data.title.toUpperCase()} ⟡ OVERVIEW V.01`}
	/>

	<!-- 2. Project Metadata Broadsheet -->
	<CaseStudyMeta
		client={data.client}
		year={data.year}
		roles={data.roles}
		deliverables={data.deliverables}
		liveUrl={slug === 'koshi' ? '/work' : undefined}
	/>

	{/* Project-Specific Editorial Storytelling */}
	{
		slug === 'koshi' ? (
			<>
				<!-- 3. Editorial Section: Context & Creative Question -->
				<EditorialSection
					eyebrow='CONTEXT // 01'
					title='The Spatial Equilibrium'
					lead='When every digital layout defaults to uniform twelve-column boxes, structure becomes an invisible cage rather than an architectural canvas.'
					layout='asymmetric'
					signature='SECTION: INQUIRY ⟡ METHOD SIGNATURE: V.02'
				>
					<p>
						In modern web development, layout decisions are all too often outsourced to heavy utility
						frameworks or rigid 12-column grids that enforce mechanical symmetry regardless of content.
						To break this monotony, developers frequently introduce heavy JavaScript resize observers
						and masonry scripts, inadvertently trading rendering performance for visual intrigue.
					</p>
					<p>
						<strong>Kōshi (格子)</strong> was conceived as Studio Eien’s internal research initiative into
						contemporary frontend architecture. It poses a fundamental creative question:
						<em>
							Can a layout system possess the mathematical rigor of traditional Japanese architectural
							lattices while enabling asymmetrical, boundary-free editorial freedom purely in native CSS?
						</em>
					</p>
					<p>
						The answer lies in embracing native browser capabilities—CSS Cascade Layers, container
						queries, and mathematical fluid clamps—to construct layouts that are simultaneously
						structured and serene.
					</p>
				</EditorialSection>

				<!-- 4. Full-Width Visual Feature -->
				<VisualFeature
					image='https://ik.imagekit.io/sorudev/Studio%20Eien/Backgrounds/mountain_INo60XpUz.png?updatedAt=1794727824146'
					alt='Mountain ink wash illustration representing structural stillness and deliberate negative space'
					caption='Lattice structure as threshold. The mountain ink wash anchors spatial equilibrium.'
					figNumber='FIG. 01'
					fullBleed={false}
					aspectRatio='21/9'
				/>

				<!-- 3b. Editorial Section: Challenge & Dual-Engine Approach -->
				<EditorialSection
					eyebrow='APPROACH // 02'
					title='Dual-Engine Mechanics: Grid Meets Boundary-Free Flex'
					lead='A single layout paradigm cannot solve all editorial demands. True craftsmanship requires choosing the exact physical tool for the spatial plane.'
					layout='asymmetric'
					signature='SECTION: MECHANICS ⟡ METHOD SIGNATURE: V.03'
				>
					<p>
						Rather than forcing all content into a singular rigid pattern, Kōshi introduces a
						dual-engine layout model built directly into Studio Eien’s CSS compositions:
					</p>
					<ul>
						<li>
							<strong>Two-Dimensional CSS Grid (<code>.kos-grid</code>):</strong> Governs macro-composition,
							explicit column allocations (1 to 12), subgrid row alignments, and dense layout flows.
						</li>
						<li>
							<strong>Boundary-Free Flexbox (<code>.kos-flex-grid</code>):</strong> Replicates fluid editorial
							broadsheets. Elements claim proportional &ldquo;shares&rdquo; of horizontal space via
							mathematical <code>flex-basis</code> calculations, adapting seamlessly as screen widths shift
							without requiring a fixed column scaffold.
						</li>
					</ul>
					<p>
						By anchoring layout constraints to <code>container-type: inline-size</code> instead of viewport
						media queries, cards and editorial modules adapt to their immediate parent container. An
						editorial component behaves with panoramic grandeur in a main feature column, yet
						instantly and gracefully refolds into a compact index item when positioned in a sidebar.
					</p>
				</EditorialSection>

				<!-- 5. Asymmetric Image Composition -->
				<AsymmetricGallery
					japaneseTitle='視覚的検証'
					eyebrow='ARTIFACT SPECIMENS // 03'
					title='Asymmetry, Measure & Negative Space'
					ratio='7-5'
					items={[
						{
							image:
								'https://ik.imagekit.io/sorudev/Studio%20Eien/Backgrounds/magazine_cover_manga_5__kFkAQWP5U.png?updatedAt=1708435704056',
							alt: 'Editorial broadsheet composition specimen demonstrating high-contrast typography and inkwork',
							caption: 'Typographic hierarchy & vertical measure',
							figNumber: 'SPECIMEN A',
							span: 7,
						},
						{
							image:
								'https://ik.imagekit.io/sorudev/Studio%20Eien/Backgrounds/forest_shrine1_8CHVgJTxRh.png?updatedAt=1794727812644',
							alt: 'Forest shrine geometry showing architectural balance and natural rhythm',
							caption: 'Architectural threshold and proportion',
							figNumber: 'SPECIMEN B',
							span: 5,
						},
						{
							image:
								'https://ik.imagekit.io/sorudev/Studio%20Eien/Backgrounds/magazine_cover_manga_aIgWKOCZh.png?updatedAt=1708435702457',
							alt: 'Manga screentone lines and delicate hatching detail',
							caption: 'Screentone texture & boundary contrast',
							figNumber: 'SPECIMEN C',
							span: 12,
						},
					]}
				/>

				<!-- 6. Design and Engineering Highlights -->
				<TechHighlights
					japaneseTitle='技術仕様'
					eyebrow='ARCHITECTURE // 04'
					title='Four Structural Pillars'
					summary='Engineered without build-time compilation loops, runtime JavaScript dependencies, or CSS-in-JS abstractions.'
					items={[
						{
							number: '01',
							title: 'Container Query Contexts',
							subtitle: 'Autonomous Component Reflow',
							description:
								'Every layout container establishes an inline container-type. Columns auto-collapse based on local width thresholds (@container kos-cq), eliminating brittle viewport-level breakpoint overrides.',
							tags: ['Container Queries', 'CSS Grid', 'Zero-JS'],
						},
						{
							number: '02',
							title: 'Boundary-Free Proportional Flex',
							subtitle: 'Adaptive Row Shares',
							description:
								'Custom [kos-col-span="N"] attributes translate directly into proportional flex-grow and gutter-compensated basis calculations, granting items exact visual weight without arbitrary wrappers.',
							tags: ['Flexbox', 'Math Calcs', 'CSS Custom Props'],
						},
						{
							number: '03',
							title: 'Cascade Layer Isolation',
							subtitle: 'Predictable Specificity Hierarchy',
							description:
								'Layout rules reside strictly within @layer compositions. This guarantees zero specificity wars when individual case study components or utility overrides are introduced.',
							tags: ['@layer', 'CSS Architecture'],
						},
						{
							number: '04',
							title: 'Fluid Typographic Clamping',
							subtitle: 'Utopia Calculator Integration',
							description:
								'Type scales seamlessly scale from --fs-step-000 (11.85px) to --fs-step-12 (230px) using single mathematical clamp formulas mapped across 375px to 1440px viewports without stepped jumping.',
							tags: ['Fluid Typography', 'Design Tokens'],
						},
					]}
					signature='SECTION: SPECIFICATION ⟡ SYSTEM COMPOSITION V.04'
				/>

				<!-- 7. Project Reflection -->
				<ProjectReflection
					japaneseTitle='振り返り'
					eyebrow='RETROSPECTIVE // 05'
					japaneseWatermark='格子'
					title='Form, Void, and Longevity'
					quote='Structure is not a constraint on expression; it is the prerequisite for intentional freedom. Like the cedar frames of a traditional machiya house, the grid gives meaning to the empty spaces within.'
					signature='STUDIO EIEN ⟡ CRAFT ARCHIVE 2026'
				>
					<p>
						Building Kōshi reinforced Studio Eien’s foundational philosophy: the most enduring digital
						experiences are not built on fleeting JavaScript trends or decorative excess, but on deep
						respect for foundational web standards.
					</p>
					<p>
						By stripping away unnecessary preprocessor abstractions and investing in native CSS
						primitives, Kōshi achieves total layout flexibility with instantaneous load times and zero
						runtime overhead. It now serves as the compositional spine for all of Studio Eien’s digital
						editorials.
					</p>
				</ProjectReflection>
			</>
		) : slug === 'kangae' ? (
			<>
				<!-- 3. Editorial Section: The Idea -->
				<EditorialSection
					eyebrow='THE IDEA // 01'
					title='Think With AI, Not Through AI'
					lead='When accepting generated code becomes second nature, the quiet habit of reasoning through a system can slip away.'
					layout='asymmetric'
					signature='SECTION: PREMISE ⟡ METHOD SIGNATURE: V.02'
				>
					<p>
						<em>Kangae</em> (考え) is the Japanese word for <em>thought</em>, <em>thinking</em>, or <em>an idea</em>.
					</p>
					<p>
						The project grew out of a personal tension in my daily engineering workflow. Working alongside AI
						coding assistants provided undeniable momentum, but I noticed a subtle pattern forming: whenever I
						encountered a tricky layout edge case or an unfamiliar API, it was tempting to let the assistant generate
						the entire block and move on.
					</p>
					<p>
						The features shipped and the tests passed, but I often closed my editor without a clear mental model of how
						the pieces actually fit together.
					</p>
					<p>
						Kangae started as an effort to restore that balance. It is not an argument against AI, nor a refusal of
						generated code. Rather, it is an intentional boundary: <strong>use AI for thoughtful leverage without
						outsourcing the thinking that builds capability.</strong>
					</p>
					<p>
						Automate repetitive boilerplate and mechanical syntax lookup, but protect the reasoning, debugging, and
						experimentation that develop long-term engineering judgment.
					</p>
				</EditorialSection>

				<!-- 4. Full-Width Visual Feature -->
				<VisualFeature
					image='https://ik.imagekit.io/sorudev/Studio%20Eien/Backgrounds/forest_shrine1_8CHVgJTxRh.png?updatedAt=1794727812644'
					alt='Serene Japanese forest shrine geometry evoking intentional space, focus, and quiet balance'
					caption='One portable folder (.kangae/). Vendor-neutral Markdown instructions that guide collaboration in compatible AI tools.'
					figNumber='FIG. 01'
					fullBleed={false}
					aspectRatio='21/9'
				/>

				<!-- 3b. Editorial Section: The Approach -->
				<EditorialSection
					eyebrow='THE APPROACH // 02'
					title='Learning Through Friction'
					lead='Real understanding requires some resistance. Assistance should remove the friction that wastes attention, not the friction that cultivates skill.'
					layout='asymmetric'
					signature='SECTION: DIALECTIC ⟡ METHOD SIGNATURE: V.03'
				>
					<p>
						When debugging, our first impulse is often to paste the error log and ask for the fix. But skipping
						straight to the answer bypasses the most informative step in software engineering: forming a hypothesis,
						predicting runtime behavior, and gathering evidence to test it.
					</p>
					<p>
						Kangae frames this around a simple guideline called <strong>The Ownership Rule</strong>: before asking the
						assistant to solve a problem, consider whether doing so saves tedious, mechanical work or removes useful
						practice. If it exercises a skill you are actively developing, prefer collaboration over immediate completion.
					</p>
					<p>
						In practice, the workflow encourages a four-step interaction loop:
					</p>
					<ul>
						<li>
							<strong>Struggle:</strong> Engage with the problem first, clarify symptoms, and form an initial hypothesis.
						</li>
						<li>
							<strong>Assist:</strong> The assistant offers the smallest nudge likely to unblock you—a focused question or conceptual pointer.
						</li>
						<li>
							<strong>Understand:</strong> Verify the result, interpret test or DevTools evidence, and explain the mechanism.
						</li>
						<li>
							<strong>Return Control:</strong> Once the blocker is clear, the assistant steps back and returns ownership of the code to you.
						</li>
					</ul>
				</EditorialSection>

				<!-- 3c. Editorial Section: The System -->
				<EditorialSection
					eyebrow='THE SYSTEM // 03'
					title='A Workflow, Not Another App'
					lead='Rather than building a separate IDE or proprietary desktop app, Kangae is packaged as a portable folder of Markdown instructions that lives directly in your project.'
					layout='asymmetric'
					signature='SECTION: ARCHITECTURE ⟡ METHOD SIGNATURE: V.04'
				>
					<p>
						Kangae requires no build step, no browser extension, and no cloud account. It exists as a vendor-neutral
						<code>.kangae/</code> folder containing readable Markdown documents. Pointing an AI coding assistant at
						<code>KANGAE.md</code> establishes a shared set of collaboration conventions.
					</p>
					<p>
						The repository is structured into two core layers:
					</p>
					<ul>
						<li>
							<strong>The Core Protocol (<code>KANGAE.md</code>):</strong> Always-on collaboration guidelines that
							adapt naturally across three working contexts: <em>Build</em> (preserving ownership while implementing),
							<em>Study</em> (active recall and conceptual practice), and <em>Review</em> (evidence-backed critique and
							tradeoff analysis).
						</li>
						<li>
							<strong>Reusable Skills (<code>skills/</code>):</strong> On-demand workflow templates for recurring tasks,
							including <code>debug-with-me</code> (hypothesis-first debugging), <code>review-this</code> (risk-prioritized
							chunk-by-chunk PR reviews), <code>understand-code</code> (guided codebase exploration), <code>reconstruct</code>
							(re-implementing concepts after assistance), and <code>journal</code> (structured session reflections).
						</li>
					</ul>
					<p>
						Because these are natural language instructions, they do not act as rigid programmatic constraints. Instead,
						they provide clear behavioral patterns that help both developer and assistant stay aligned on learning goals.
					</p>
				</EditorialSection>

				<!-- 5. Editorial Section: The Interaction Model -->
				<EditorialSection
					eyebrow='THE INTERACTION MODEL // 04'
					title='Guidance Without Taking Over'
					lead='True leverage is not about surrendering the keyboard. It is about a calibrated dialogue that offers the smallest nudge needed to unblock you, then promptly returns control.'
					layout='asymmetric'
					signature='SECTION: PROTOCOL ⟡ METHOD SIGNATURE: V.05'
				>
					<p>
						In traditional AI tooling, assistance is binary: either the assistant generates the whole file,
						or it does nothing. Kangae replaces this all-or-nothing dynamic with an <strong>Internal Assistance Ladder</strong>.
					</p>
					<p>
						When you encounter an obstacle, the assistant is instructed to offer the least help likely to move you forward:
					</p>
					<ul>
						<li>
							<strong>Targeted Inquiry:</strong> Asking a clarifying question about assumptions or expected runtime behavior before proposing changes.
						</li>
						<li>
							<strong>Conceptual Pointers:</strong> Directing attention toward relevant documentation, container constraints, or suspicious lines of code.
						</li>
						<li>
							<strong>Structural Scaffolding:</strong> Providing pseudocode or algorithmic outlines for you to implement yourself.
						</li>
						<li>
							<strong>Fallback Solutions:</strong> Providing complete code snippets only when lower levels are insufficient or when fundamentally blocked.
						</li>
					</ul>
					<p>
						Crucially, assistance is paired with the <strong>Return-Control Protocol</strong>. As soon as you demonstrate
						understanding of the mechanism—whether by explaining a DevTools measurement or articulating the next step—the
						assistant steps back. It never lingers to write the surrounding code for you.
					</p>
					<p>
						By maintaining this boundary, sessions feel like collaborating with a thoughtful peer: one who challenges you
						to understand your own architecture while leaving the agency and the satisfaction of building firmly in your hands.
					</p>
				</EditorialSection>

				<!-- 6. Design and Engineering Highlights -->
				<TechHighlights
					japaneseTitle='技術仕様'
					eyebrow='FOUNDATIONS // 05'
					title='Four Tenets of Mindful Collaboration'
					summary='Structured guidelines designed to shape assistant collaboration without vendor lock-in or cognitive overhead.'
					items={[
						{
							number: '01',
							title: 'Internal Assistance Ladder',
							subtitle: 'Graduated Help Without Manual Toggles',
							description:
								'The assistant is instructed to start with the least help likely to move you forward—a question or conceptual pointer—escalating to pseudocode or concrete examples only when you are fundamentally blocked.',
							tags: ['Adaptive Guidance', 'Cognitive Support', 'Ownership'],
						},
						{
							number: '02',
							title: 'The Return-Control Protocol',
							subtitle: 'Preventing Quiet Dependency',
							description:
								'Assistance does not mean taking permanent ownership. Once an obstacle is clarified, the assistant asks what you would do next, stepping back to let you continue implementing.',
							tags: ['Agency', 'Collaboration', 'Flow State'],
						},
						{
							number: '03',
							title: 'Context-Fluid Interaction',
							subtitle: 'Build, Study, and Review Modes',
							description:
								'A single session can shift naturally between writing features, practicing active recall on unfamiliar syntax, and conducting evidence-backed code reviews without manually toggling modes.',
							tags: ['Code Review', 'Active Recall', 'Context Awareness'],
						},
						{
							number: '04',
							title: 'Portable Markdown Architecture',
							subtitle: 'One Portable Folder (.kangae/)',
							description:
								'Packaged entirely as plain Markdown files. Kangae can be dropped into any project root, kept local to a clone via .git/info/exclude, and referenced across different compatible AI tools.',
							tags: ['Markdown Protocol', 'Git Local', 'Vendor-Neutral'],
						},
					]}
					signature='SECTION: SPECIFICATION ⟡ KANGAE SYSTEM V.04'
				/>

				<!-- 7. Project Reflection -->
				<ProjectReflection
					japaneseTitle='振り返り'
					eyebrow='RETROSPECTIVE // 06'
					japaneseWatermark='考え'
					title='Understanding is the Outcome'
					quote='The objective is not to produce the most code in the shortest amount of time. It is to solve problems effectively while continuously improving your ability to solve future problems yourself.'
					signature='STUDIO EIEN ⟡ MINDFUL WORKFLOWS 2026'
				>
					<p>
						Using Kangae has quietly reshaped my day-to-day work. It hasn’t turned me into a radically different
						engineer, nor does it make working with AI effortless. But it has established a helpful habit: pausing
						for a moment to reason through a problem before asking for an answer.
					</p>
					<p>
						When working with an AI assistant feels like a thoughtful technical dialogue rather than an automated code
						generator, programming retains its creative spark. You finish a session with work you genuinely understand,
						and the quiet satisfaction of knowing you could build it again on your own.
					</p>
				</ProjectReflection>
			</>
		) : slug === 'mika' ? (
			<>
				<!-- 3. Editorial Section: Context & The High-Arousal Financial Problem -->
				<EditorialSection
					eyebrow='CHALLENGE // 01'
					title='The Sensory Overload of Modern Finance'
					lead='Mainstream budgeting applications weaponize anxiety: flashing crimson banners, judgmental notifications, and cluttered charts that trigger avoidance rather than clarity.'
					layout='asymmetric'
					signature='SECTION: CHALLENGE ⟡ METHOD SIGNATURE: V.02'
				>
					<p>
						Most digital finance tools are designed around high-arousal sensory stimulation. Red deficit
						callouts, casino-like gamification rings, and persistent notifications turn simple financial
						check-ins into experiences of shame and dread.
					</p>
					<p>
						For neurodivergent individuals—especially those navigating ADHD or executive dysfunction—this
						visual clutter creates intense cognitive friction. When opening a budget app feels like facing an
						accusation, the natural human response is complete avoidance, causing financial health to suffer
						in silence.
					</p>
					<p>
						<strong>Mika (美香)</strong> was born from a desire to create a profoundly different experience:
						an unhurried, reassuring sanctuary where money is managed with quiet confidence and emotional peace.
					</p>
				</EditorialSection>

				<!-- 4. Full-Width Visual Feature -->
				<VisualFeature
					image='https://ik.imagekit.io/sorudev/Studio%20Eien/Backgrounds/lakewithleaves_FY9DAwWQ_.png?updatedAt=1794727823633'
					alt='Serene lake with floating autumn leaves evoking emotional stillness and financial clarity'
					caption='Still water over turbulent charts. Mika replaces punitive alerts with emotional equilibrium.'
					figNumber='FIG. 01'
					fullBleed={false}
					aspectRatio='21/9'
				/>

				<!-- 3b. Editorial Section: Approach & Broadsheet Clarity -->
				<EditorialSection
					eyebrow='APPROACH // 02'
					title='Broadsheet Clarity & Low-Arousal Interaction'
					lead='Budgeting reimagined as a peaceful morning ritual. No flashing alarms, no judgmental scores, no sensory noise.'
					layout='asymmetric'
					signature='SECTION: ARCHITECTURE ⟡ METHOD SIGNATURE: V.03'
				>
					<p>
						Mika discards the dashboard metaphor entirely. Drawing inspiration from traditional Japanese
						merchant ledgers (<em>Daifukuchō</em> 大福帳) and minimalist editorial broadsheets, the interface
						presents financial information with spacious, calm typography and soft, paper-like tonality.
					</p>
					<ul>
						<li>
							<strong>Zero-Judgment Visual Language:</strong> Deficits and surpluses are communicated through
							deliberate typographic measure and layout hierarchy, entirely eliminating aggressive red hues.
						</li>
						<li>
							<strong>Single-Horizon Decision Making:</strong> The interface presents only one decision at a
							time—such as reviewing weekly groceries or categorizing an unassigned transaction—preventing
							the cognitive paralysis of 50-row spreadsheets.
						</li>
						<li>
							<strong>Tactile Ledger Rhythm:</strong> Generous whitespace and muted dividers transform daily
							accounting into an orderly, reassuring ritual.
						</li>
					</ul>
					<p>
						By respecting human sensory limits, Mika turns budgeting from an intimidating chore into a
						grounding daily practice.
					</p>
				</EditorialSection>

				<!-- 5. Asymmetric Image Composition -->
				<AsymmetricGallery
					japaneseTitle='平穏な設計'
					eyebrow='SENSORY ARTIFACTS // 03'
					title='Deliberate Pace & Tactile Restraint'
					ratio='7-5'
					items={[
						{
							image:
								'https://ik.imagekit.io/sorudev/Studio%20Eien/Backgrounds/manga_beautiful_7qMh10Vza.png?updatedAt=1708505549765',
							alt: 'Tactile ledger typography specimen with gentle paper-like tones and clear hierarchies',
							caption: 'Quiet ledger typography & soft contrast balance',
							figNumber: 'SPECIMEN A',
							span: 7,
						},
						{
							image:
