---
import Layout from '../layouts/DefaultLayout.astro';
import Navbar from '../components/astro/Navbar.astro';
import Footer from '../components/astro/Footer.astro';
import Button from '@/components/astro/button.astro';
---

<Layout title='Studio Eien' description='Studio'>
	<main>
		<Navbar />
		<section class='hero hero-content'>
			<div class='container'>
				<header>
					<div class='hero__title'>
						<span class='text-accent'>すたじお</span>
						<h1>Our Studio</h1>
					</div>

					<p>
						Studio Eien is a frontend-focused design practice dedicated to building thoughtful
						digital experiences. We work with businesses, creators, and artists to transform ideas
						into structured, scalable websites that feel intentional and refined.
					</p>
				</header>
			</div>
		</section>

		<div class='decoration' data-type='full-bleed'>
			<div class='container' data-type='full-bleed'>
				<hr />
				<div class='decoration__text__end'>
					<p>SECTION: STUDIO ⟡ METHOD SIGNATURE: V.01</p>
				</div>
			</div>
		</div>

		<section class='studio-story'>
			<div class='container studio-story__grid' data-type='wide'>
				<header class='studio-story__header'>
					<div class='studio-story__title'>
						<h3>
							Studio Eien began with a simple idea: to help people bring their visions into the
							world.
						</h3>
					</div>
				</header>
				<div class='studio-story__body flow-large'>
					<p>
						For artists, creatives, and businesses, a website can be more than a place to share
						information. It can be a starting point, a home for their work, and an expression of who
						they are.
					</p>

					<p>
						The name Eien 永遠, meaning eternity in Japanese, draws inspiration from the quiet
						beauty of Japanese forest shrines. Places shaped by time, where nature and craftsmanship
						exist together, carrying a sense of permanence through generations.
					</p>
					<p>
						That same appreciation for thoughtful creation shapes Studio Eien. It's a place to
						explore ideas, practice our craft, and build digital experiences that feel personal,
						expressive, and made to last.
					</p>
				</div>
			</div>
		</section>

		<div class='decoration' data-type='full-bleed'>
			<div class='container' data-type='full-bleed'>
				<hr />
				<div class='decoration__text__end'>
					<p>SECTION: STORY ⟡ METHOD SIGNATURE: V.02</p>
				</div>
			</div>
		</div>

		<section class='behind-studio'>
			<div class='container behind-studio__grid' data-type='wide'>
				<header class='behind-studio__header'>
					<div class='behind-studio__title'>
						<span class='text-accent'>つくりて</span>
						<h3>Behind the studio.</h3>
					</div>
				</header>
				<figure class='behind-studio__picture'>
					<img src='/assets/img/forest_shrine.jpg' alt='Quiet beauty of a Japanese forest shrine' />
					<figcaption class='behind-studio__caption'>
						<span>FIG. 01 — EIEN ARCHIVE</span>
						<span>森の神社 ⟡ 2026</span>
					</figcaption>
				</figure>
				<div class='behind-studio__bio flow-large'>
					<p>
						Studio Eien is an independent creative practice founded by Kaleb Berry, a frontend
						developer with a love for design, technology, and the creative possibilities of the
						web.
					</p>

					<p>
						My work is rooted in a love for bringing ideas to life through code. From thoughtful
						layouts and expressive interactions to the systems that hold everything together, I
						enjoy exploring how design and engineering can create experiences that feel both
						beautiful and purposeful.
					</p>
					<p>
						Studio Eien gives me the freedom to pursue that craft while working directly with
						people who have something they want to share with the world. For me, the most
						rewarding part is creating something together that they're genuinely excited to call
						their own.
					</p>
				</div>
			</div>
		</section>

		<div class='decoration' data-type='full-bleed'>
			<div class='container' data-type='full-bleed'>
				<hr />
				<div class='decoration__text__end'>
					<p>SECTION: STUDIO ⟡ METHOD SIGNATURE: V.01</p>
				</div>
			</div>
		</div>

		<section class='conversion container'>
			<header class='flow'>
				<div class='conversion__title'>
					<span>はじまり</span>
					<h2>START YOUR STORY</h2>
				</div>
				<p>
					Step into our creative process, where ideas become impact. Explore client case studies and
					see how Studio Eien transforms visions into soulful, strategic web design.
				</p>
				<Button content='Lets Work Together' />
			</header>
		</section>
		<div class='decoration'>
			<div class='container' data-type='full-bleed'>
				<hr />
				<div class='decoration__text__end'>
					<p>SECTION: START YOUR STORY ⟡ METHOD SIGNATURE: V.03</p>
				</div>
			</div>
		</div>
	</main>

	<Footer />
</Layout>
